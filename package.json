{
  "name": "sneakers",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
