    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
