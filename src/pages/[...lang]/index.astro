---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { toShoe } from '@/entities/shoe';
import { MY_PARAMS, MY_SIZE } from '@/shared/config';
import { getTranslations, LOCALES, type Locale, langParam } from '@/shared/i18n';
import { ShoeCatalog } from '@/widgets/shoe-catalog';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: langParam(locale) } }));
}

const locale = Astro.currentLocale as Locale;
const t = getTranslations(locale);

const entries = await getCollection('shoes');
const shoes = await Promise.all(
  entries.map(async (entry) => ({
    ...toShoe(entry, locale),
    href: getRelativeLocaleUrl(locale, `shoes/${entry.id}`),
    // The label's square thumbnail (~180px on the wall, 2x); none = the label's placeholder
    thumb: entry.data.poster && (await getImage({ src: entry.data.poster, height: 360 })).src,
  })),
);

shoes.sort((a, b) => b.year - a.year);
---

<BaseLayout title={t.siteTitle}>
  <h1 class="text-3xl font-semibold">{t.catalogHeading}</h1>
  <p class="mt-1 mb-6 text-sm text-muted-foreground" data-testid="my-params">
    {t.size} <span class="font-medium text-foreground">{MY_SIZE}</span> · {t.footLength}{' '}
    <span class="font-medium text-foreground">{MY_PARAMS.footCm} {t.cm}</span>
  </p>
  <ShoeCatalog client:load shoes={shoes} locale={locale} />
</BaseLayout>
